#!/bin/bash

# 1. Define Variables
POKEMON_NAME="pikachu"
API_URL="https://pokeapi.co/api/v2/pokemon/${POKEMON_NAME}"
DATA_FILE="data.json"
ERROR_FILE="errors.txt"

# 2. Make the API Request
# -s: Silent (hide progress bar)
# -o: Output the JSON response to a file immediately
# -w: Write the HTTP status code (e.g., 200, 404) to standard output
HTTP_STATUS=$(curl -s -o "$DATA_FILE" -w "%{http_code}" "$API_URL")

# 3. Check for Success (HTTP 200 OK)
if [ "$HTTP_STATUS" -eq 200 ]; then
    echo "Success: Data for ${POKEMON_NAME} saved to ${DATA_FILE}."
else
    # 4. Error Handling
    TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[${TIMESTAMP}] Error: Failed to retrieve data for ${POKEMON_NAME}. HTTP Status: ${HTTP_STATUS}" >> "$ERROR_FILE"
    
    # Clean up empty file if the request failed
    if [ -f "$DATA_FILE" ]; then
        rm "$DATA_FILE"
    fi
    
    echo "Failed: Error logged to ${ERROR_FILE}."
    exit 1
fi