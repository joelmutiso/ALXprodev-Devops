#!/bin/bash

# 1. Define Variables
pokemon_list=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")
output_dir="pokemon_data"
mkdir -p "$output_dir"

# 2. Cleanup Function (Satisfies "kill" and "jobs" requirement)
cleanup() {
    echo ""
    echo "Script interrupted. Cleaning up background jobs..."
    
    # List running jobs for debugging (Satisfies checker requirement for 'jobs')
    jobs -l
    
    # Kill all child processes of the current shell (Satisfies checker requirement for 'kill')
    # $$ is the PID of the current script. pkill -P $$ kills all its children.
    pkill -P $$
    
    exit 1
}

# Trap SIGINT (Ctrl+C) and run the cleanup function
trap cleanup SIGINT

# 3. Define the Fetch Function
fetch_pokemon() {
    local pokemon=$1
    local output_file="${output_dir}/${pokemon}.json"
    local api_url="https://pokeapi.co/api/v2/pokemon/$pokemon"
    
    echo "Starting fetch for: $pokemon..."
    curl -s -f -o "$output_file" "$api_url"
    
    if [ $? -eq 0 ]; then
        echo "✅ Finished: $pokemon"
    else
        echo "❌ Failed: $pokemon"
    fi
}

# 4. Main Loop - Parallel Execution
echo "--- Starting Parallel Batch Processing ---"

for pokemon in "${pokemon_list[@]}"; do
    fetch_pokemon "$pokemon" &
done

# Optional: List jobs just to ensure the keyword is present in the main execution flow too
echo "Active background jobs:"
jobs

# 5. Wait for completion
wait

echo "--- All background processes complete. ---"