#!/bin/bash

# 1. Define the list of Pokemon
# We use lowercase because the PokeAPI URLs require lowercase names.
pokemon_list=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")

# 2. Create the output directory if it doesn't exist
output_dir="pokemon_data"
mkdir -p "$output_dir"

# 3. Loop through the list
for pokemon in "${pokemon_list[@]}"; do
    echo "Fetching data for $pokemon..."
    
    # Construct the filename and URL
    output_file="${output_dir}/${pokemon}.json"
    api_url="https://pokeapi.co/api/v2/pokemon/$pokemon"
    
    # Fetch data
    # -s: Silent mode
    # -o: Output to file
    curl -s -o "$output_file" "$api_url"
    
    echo "Saved data to $output_file ✅"
    
    # 4. Rate Limiting
    # Sleep for 2 seconds to avoid hitting API rate limits
    sleep 2
done