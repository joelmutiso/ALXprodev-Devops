#!/bin/bash

# Ensure data.json exists
if [ ! -f "data.json" ]; then
    echo "Error: data.json not found. Please run task 0 first."
    exit 1
fi

# 1. Extract and Capitalize Name and Type
name=$(jq -r '.name' data.json | sed 's/\b[a-z]/\U&/g')
type=$(jq -r '.types[0].type.name' data.json | sed 's/\b[a-z]/\U&/g')

# 2. Extract Raw Height and Weight
raw_height=$(jq -r '.height' data.json)
raw_weight=$(jq -r '.weight' data.json)

# 3. Perform Calculations using awk
formatted_height=$(echo "$raw_height" | awk '{print $1/10}')
formatted_weight=$(echo "$raw_weight" | awk '{print $1/10}')

# 4. Final Output
echo "$name is of type $type, weighs ${formatted_weight}kg, and is ${formatted_height}m tall."