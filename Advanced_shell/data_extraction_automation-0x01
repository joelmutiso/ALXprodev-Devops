#!/bin/bash

# Ensure data.json exists
if [ ! -f "data.json" ]; then
    echo "Error: data.json not found. Please run task 0 first."
    exit 1
fi

# Pipeline Explanation:
# 1. jq: Extracts name, height, weight, and the first type. Outputs as CSV (e.g., "pikachu,4,60,electric").
# 2. sed: Uses a regex to find the first letter of every word (\b[a-z]) and uppercase it (\U&).
# 3. awk: Sets comma as separator (-F,), performs division for metric conversion, and prints the formatted string.

jq -r '"\(.name),\(.height),\(.weight),\(.types[0].type.name)"' data.json | \
sed 's/\b[a-z]/\U&/g' | \
awk -F, '{
    printf "%s is of type %s, weighs %gkg, and is %gm tall.\n", $1, $4, $3/10, $2/10
}'